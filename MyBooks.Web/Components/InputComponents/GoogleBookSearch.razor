@using MyBooks.Shared.Dtos
@using MyBooks.Application.Interfaces
@inject IGoogleBooksUseCase googleBookService

<div class="search-books-container">
    <div class="search-field">
        <input type="text" @bind="searchText" placeholder="Search title or author."/>
        <button  class="btn-primary" @onclick="SearchBooks">Search</button>
    </div>
        @if(!string.IsNullOrEmpty(errorMessage))
        {
            <p>@errorMessage</p>
        }
        @if(booksList.Count > 0)
        {
            <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Publicación</th>
                    <th>Páginas</th>
                </tr>
            </thead>
                <tbody>
                    @foreach (var book in booksList)
                    {
                        <tr @onclick="() => SelectBook(book)" class="@(book == selectedBook ? "row-selected" :"")">
                            <td class="col-title">@book.Title</td>
                            <td>@string.Join(", ", book.Authors)</td>
                            <td>@book.PublishedYear</td>
                            <td>@book.PageCount</td>
                        </tr>
                    }
                </tbody>
            </table>      
        }
</div>



@code {
    [Parameter]
    public string InitialTitle { get; set; } = string.Empty;
    [Parameter]
    public string InitialAuthor { get; set; } = string.Empty;
    [Parameter]
    public EventCallback<GoogleBookDto> OnBookSelected { get; set; }

    private string searchText = string.Empty;
    private List<GoogleBookDto> booksList = [];
    private GoogleBookDto? selectedBook;
    private string errorMessage = string.Empty;


    //TODO: Contolar errores.
    //TODO: Testear funciones
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(InitialTitle) || !string.IsNullOrEmpty(InitialAuthor))
        {
            searchText = $"{InitialTitle} {InitialAuthor}".Trim();
            var result = await googleBookService.GetBookByTitleAndAuthor(InitialTitle, InitialAuthor);
            if (result.IsSuccess)
            {
                booksList = result.Data ?? [];
                errorMessage = string.Empty;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        else
        {
            booksList = [];
            searchText = string.Empty;
        }    
    }

    private async Task SearchBooks()
    {
        if (string.IsNullOrEmpty(searchText))
        {
            errorMessage = string.Empty;
            return;
        }
       
        var result = await googleBookService.GetBookByQuery(searchText);
        if(result.IsSuccess)
        {
            booksList = result.Data ?? [];
            errorMessage = string.Empty;
        }
        else
        {
            errorMessage = result.Message;
        }
    }

    private async Task SelectBook(GoogleBookDto book)
    {
        selectedBook = book;

        await OnBookSelected.InvokeAsync(book);
    }
}
