@using MyBooks.Shared.Dtos
@using MyBooks.Web.Models

@if (editBookInternal != null)
{
    <div class="book-edit-form">
        <div class="form-header">
            <span class="form-filename">@editBookInternal.FileName</span>
        </div>

        <div class="form-field">
            <label>Título</label>
            <input type="text" @bind="editBookInternal.Title" placeholder="Título" />
        </div>

        <div class="form-field">
            <label>Autor</label>
            @* TODO: Mostrar todos los autores de la lista *@
            <input type="text" @bind="editBookInternal.Author[0]" placeholder="Autor" />
        </div>

        <div class="form-field">
            <label>Título Google Books</label>
            <input type="text" @bind="editBookInternal.ExternalApiTitle" placeholder="Google Books título" />
        </div>

        <div class="form-field">
            <label>Fecha publicación</label>
            <input type="text" @bind="editBookInternal.PublishYear" placeholder="Ej: 2016" />
        </div>

        <div class="form-field">
            <label>Páginas</label>
            <input type="text" @bind="editBookInternal.PageNumber" placeholder="Ej: 235" />
        </div>

        <GoogleBookSearch InitialTitle="@editBookInternal.Title" InitialAuthor="@string.Join(", ", editBookInternal.Author)" OnBookSelected="HandleBookSelected" />

        <div class="form-actions">
            <button class="btn-primary" @onclick="HandleSave" disabled="@(!editBookInternal.isValid)">Guardar</button>
        </div>       
    </div>
}


@code {
    //TODO: si el libro es nulo mostrar mensaje
    //TODO: Las pestañas y el formulario no se ven bien, me gustaría que la pestaña formara parte visualmente del formulario.
    //TODO: Al guardar pensar como cerrar la pestaña, si dejarla abierta y poder cerrar manualmente o cerrar directamente al guardar.
    [Parameter]
    public BookImportedVM? EditBook { get; set; }
    [Parameter]
    public EventCallback<BookImportedVM> OnSave { get; set; }

    private BookImportedVM? editBookInternal;

    protected override void OnParametersSet()
    {
        if(EditBook is not null)
        {
            editBookInternal = EditBook;
        }
    }

    private async Task HandleSave()
    {
        await OnSave.InvokeAsync(editBookInternal);
    }

    private void HandleBookSelected(GoogleBookDto googleBook)
    {
        if (editBookInternal is null) return;

        editBookInternal.ExternalApiTitle = googleBook.Title;
        editBookInternal.Author = googleBook.Authors;
        editBookInternal.PageNumber = googleBook.PageCount;
        editBookInternal.PublishYear = googleBook.PublishedYear;
        editBookInternal.Description = googleBook.Description;
        editBookInternal.SmallImage = googleBook.SmallImage;
        editBookInternal.BigImage = googleBook.BigImage;
    }

}
